{
  "openapi": "3.1.0",
  "info": {
    "title": "Hiring Record Synthetic Demo API",
    "version": "0.2.0",
    "description": "Local demo API. Synthetic data only; not a production multi-tenant service. MCP tools are read-only."
  },
  "servers": [
    {
      "url": "/"
    }
  ],
  "paths": {
    "/health": {
      "get": {
        "summary": "Liveness check",
        "parameters": [],
        "responses": {
          "200": {
            "description": "Successful response"
          },
          "400": {
            "description": "Invalid input"
          },
          "503": {
            "description": "Storage unavailable"
          }
        }
      }
    },
    "/ready": {
      "get": {
        "summary": "Storage readiness check",
        "parameters": [],
        "responses": {
          "200": {
            "description": "Successful response"
          },
          "400": {
            "description": "Invalid input"
          },
          "503": {
            "description": "Storage unavailable"
          }
        }
      }
    },
    "/v1/roles/sept/view": {
      "get": {
        "summary": "Read the synthetic scenario or an event-index snapshot",
        "parameters": [
          {
            "name": "x-demo-session",
            "in": "header",
            "required": false,
            "description": "Synthetic scenario identifier, up to 80 ASCII letters, digits or hyphens. Omit for the default local scenario.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "at",
            "in": "query",
            "required": false,
            "description": "Historical event index.",
            "schema": {
              "type": "integer",
              "minimum": 0
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response"
          },
          "400": {
            "description": "Invalid input"
          },
          "503": {
            "description": "Storage unavailable"
          }
        }
      }
    },
