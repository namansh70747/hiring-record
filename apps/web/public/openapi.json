            "in": "header",
            "required": false,
            "description": "Synthetic scenario identifier, up to 80 ASCII letters, digits or hyphens. Omit for the default local scenario.",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Updated synthetic scenario"
          },
          "400": {
            "description": "Invalid session"
          },
          "403": {
            "description": "Cross-origin mutation rejected"
          },
          "409": {
            "description": "Command conflicts with current state"
